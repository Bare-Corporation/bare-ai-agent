[Unit]
Description=Bare-AI untracked-file secret scan (ticket 282)
Documentation=file:///home/bare-ai/bare-ai-agent/scripts/worker/bare-untracked-secret-scan.sh
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/bare-ai/bare-ai-agent/scripts/worker/bare-untracked-secret-scan.sh
# Exit 1 means FINDINGS, which is a successful run that has something to report. Without this the
# unit goes red every night a leak exists and the signal gets ignored within a week.
SuccessExitStatus=1
Nice=10
IOSchedulingClass=idle
